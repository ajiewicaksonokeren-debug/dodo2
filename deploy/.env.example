# Salin jadi .env (JANGAN di-commit). Semua nilai rahasia.
PUBLIC_URL=https://cms.esportsku.com
SECRET=                      # openssl rand -hex 32
TELEMETRY=false

# Supabase → Connect → "Session pooler" (IPv4). User = directus.<project-ref>, password dari supabase/cms.sql
DB_CLIENT=pg
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USER=directus.lmdpgbzwlrsbrylljpmp
DB_PASSWORD=
DB_SSL__REJECT_UNAUTHORIZED=false

# Akun Owner pertama (dibuat saat container pertama kali jalan)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opsional: staf login pakai Google (tidak ada pendaftaran publik; Owner yang membuat akunnya).
# Google Cloud → OAuth client → Authorized redirect URI: https://cms.esportsku.com/auth/login/google/callback
AUTH_PROVIDERS=google
AUTH_GOOGLE_DRIVER=openid
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_ISSUER_URL=https://accounts.google.com/.well-known/openid-configuration
AUTH_GOOGLE_IDENTIFIER_KEY=email
AUTH_GOOGLE_ALLOW_PUBLIC_REGISTRATION=false
AUTH_GOOGLE_LABEL=Google
